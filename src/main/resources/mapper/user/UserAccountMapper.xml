<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whatname.iam.mapper.user.UserAccountMapper">
  <resultMap id="account" type="com.whatname.iam.entity.user.UserAccount" autoMapping="true"><id property="id" column="id"/></resultMap>
  <sql id="columns">id,username,real_name_ciphertext,phone,phone_hash,password_hash,employee_no,dept_id,status,source,employment_type,password_initialized,session_version,grant_revision,hr_version,pwd_failed_count,pwd_locked_until,created_by,temp_reason,last_login_at,created_at,updated_at</sql>
  <select id="findById" resultMap="account">SELECT <include refid="columns"/> FROM sys_user WHERE id=#{id}</select>
  <select id="lockById" resultMap="account">SELECT <include refid="columns"/> FROM sys_user WHERE id=#{id} FOR UPDATE</select>
  <select id="lockByUsername" resultMap="account">SELECT <include refid="columns"/> FROM sys_user WHERE username=#{username} FOR UPDATE</select>
  <select id="lockByPhoneHash" resultMap="account">SELECT <include refid="columns"/> FROM sys_user WHERE phone_hash=#{phoneHash} FOR UPDATE</select>
  <select id="lockByEmployeeNo" resultMap="account">SELECT <include refid="columns"/> FROM sys_user WHERE employee_no=#{sgNo} AND BINARY employee_no=BINARY #{sgNo} FOR UPDATE</select>
  <insert id="insertHr" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sys_user(username,real_name_ciphertext,phone,phone_hash,password_hash,employee_no,dept_id,
      source,employment_type,status,password_initialized,session_version,grant_revision,hr_version,pwd_failed_count)
    VALUES(#{username},#{realNameCiphertext},#{phone},#{phoneHash},#{passwordHash},#{employeeNo},#{deptId},
      1,#{employmentType},1,0,1,1,#{hrVersion},0)
  </insert>
  <update id="updateHr">
    UPDATE sys_user SET real_name_ciphertext=#{realNameCiphertext},phone=#{phone},phone_hash=#{phoneHash},
      dept_id=#{deptId},employment_type=#{employmentType},status=#{status},session_version=#{sessionVersion},
      hr_version=#{hrVersion} WHERE id=#{id} AND source=1 AND BINARY employee_no=BINARY #{employeeNo}
  </update>
  <select id="lockEligibleDepartment" resultType="java.lang.Long">SELECT id FROM sys_dept WHERE id=#{id} AND merged_into_dept_id IS NULL FOR UPDATE</select>
  <insert id="insertTemporary" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sys_user(username,real_name_ciphertext,phone,phone_hash,password_hash,dept_id,source,status,
      password_initialized,session_version,grant_revision,hr_version,pwd_failed_count,created_by,temp_reason)
    VALUES(#{username},#{realNameCiphertext},#{phone},#{phoneHash},#{passwordHash},#{deptId},2,1,0,1,1,0,0,#{createdBy},#{tempReason})
  </insert>
  <update id="updatePassword">UPDATE sys_user SET password_hash=#{passwordHash},password_initialized=#{passwordInitialized},
    session_version=#{sessionVersion},pwd_failed_count=0,pwd_locked_until=NULL WHERE id=#{id}</update>
  <update id="updateLoginState">UPDATE sys_user SET pwd_failed_count=#{pwdFailedCount},pwd_locked_until=#{pwdLockedUntil},last_login_at=#{lastLoginAt} WHERE id=#{id}</update>
  <update id="updateStatus">UPDATE sys_user SET status=#{status},session_version=#{sessionVersion} WHERE id=#{id} AND source=2</update>
  <sql id="scopeFilter">
    <where>
      <choose><when test="scope != null and !scope.isEmpty()">
        dept_id IN <foreach collection="scope" item="dept" open="(" separator="," close=")">#{dept}</foreach>
      </when><otherwise>1=0</otherwise></choose>
      <if test="deptId != null">AND dept_id=#{deptId}</if>
      <if test="accountStatus != null">AND status=#{accountStatus}</if>
      <if test="source != null">AND source=#{source}</if>
    </where>
  </sql>
  <sql id="identifierMatch">(LOCATE(#{keyword},username)&gt;0 OR COALESCE(LOCATE(#{keyword},employee_no),0)&gt;0
    <if test="phoneHash != null">OR phone_hash=#{phoneHash}</if>)</sql>
  <sql id="filter">
    <include refid="scopeFilter"/>
    <if test="keyword != null">AND <include refid="identifierMatch"/></if>
  </sql>
  <select id="list" resultMap="account">SELECT <include refid="columns"/>
    FROM sys_user <include refid="filter"/> ORDER BY id LIMIT #{limit} OFFSET #{offset}</select>
  <select id="count" resultType="int">SELECT COUNT(*) FROM sys_user <include refid="filter"/></select>
  <select id="searchCandidates" resultMap="account">
    SELECT <include refid="columns"/>,<include refid="identifierMatch"/> AS identifier_matched
    FROM sys_user <include refid="scopeFilter"/> AND id&gt;#{afterId} ORDER BY id LIMIT #{limit}
  </select>
</mapper>
