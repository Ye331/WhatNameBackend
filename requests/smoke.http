@baseUrl = http://localhost:8080
@accessToken = {{privateAccessToken}}

### 服务是否启动；不代表数据库已经可用
GET {{baseUrl}}/api/v1/system/ping
X-Request-Id: local-ping-001

### 数据库连通性：成功200，连接失败503
GET {{baseUrl}}/api/v1/system/database

### 未实现路由应返回统一404
GET {{baseUrl}}/api/v1/not-implemented

### ========== B 第一阶段：M3 / M4 ==========

### 查询应用列表
GET {{baseUrl}}/api/v1/applications?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### 创建应用
POST {{baseUrl}}/api/v1/applications
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "appCode": "ATTEND",
  "appName": "考勤系统",
  "description": "演示业务系统"
}

### 重复应用编码应失败
POST {{baseUrl}}/api/v1/applications
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "appCode": "ATTEND",
  "appName": "重复考勤系统",
  "description": "重复编码"
}

### 修改或停用应用
PATCH {{baseUrl}}/api/v1/applications/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": 0,
  "reason": "系统维护"
}

### 查询应用菜单
GET {{baseUrl}}/api/v1/applications/1/menus
Authorization: Bearer {{accessToken}}

### 创建根目录
POST {{baseUrl}}/api/v1/applications/1/menus
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "menuCode": "ROOT",
  "menuName": "根目录",
  "menuType": 1,
  "parentId": 0,
  "path": "/root"
}

### 创建权限菜单
POST {{baseUrl}}/api/v1/applications/1/menus
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "menuCode": "QUERY",
  "menuName": "考勤查询",
  "menuType": 2,
  "parentId": 1,
  "path": "/attendance/query"
}

### 菜单形成自循环应失败
PATCH {{baseUrl}}/api/v1/menus/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parentId": 1,
  "reason": "循环测试"
}

### 查询应用 API
GET {{baseUrl}}/api/v1/applications/1/apis?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### 登记 API
POST {{baseUrl}}/api/v1/applications/1/apis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "apiCode": "ATTEND_LIST",
  "apiName": "考勤记录查询",
  "apiPath": "/attendance/records/{id}",
  "httpMethod": "GET"
}

### 重复/歧义 API 路由应失败
POST {{baseUrl}}/api/v1/applications/1/apis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "apiCode": "ATTEND_LIST_2",
  "apiName": "考勤记录查询2",
  "apiPath": "/attendance/records/{recordId}",
  "httpMethod": "GET"
}

### 停用 API
PATCH {{baseUrl}}/api/v1/apis/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": 0,
  "reason": "接口停用"
}

### 查询菜单关联 API
GET {{baseUrl}}/api/v1/menus/2/apis
Authorization: Bearer {{accessToken}}

### 全量替换菜单关联 API
PUT {{baseUrl}}/api/v1/menus/2/apis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "apiIds": [1],
  "expectedVersion": "v1"
}

### 版本号重复提交应失败
PUT {{baseUrl}}/api/v1/menus/2/apis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "apiIds": [1],
  "expectedVersion": "v1"
}

### 查询角色列表
GET {{baseUrl}}/api/v1/roles?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### 创建角色
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleCode": "ATTEND_STAFF",
  "roleName": "考勤人员",
  "roleType": 1,
  "description": "考勤岗位"
}

### 查询角色详情
GET {{baseUrl}}/api/v1/roles/1
Authorization: Bearer {{accessToken}}

### 修改或停用角色
PATCH {{baseUrl}}/api/v1/roles/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": 0,
  "reason": "岗位调整"
}

### 查询角色菜单
GET {{baseUrl}}/api/v1/roles/1/menus
Authorization: Bearer {{accessToken}}

### 替换角色全部菜单
PUT {{baseUrl}}/api/v1/roles/1/menus
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "menuIds": [2],
  "expectedVersion": "v1"
}

### 角色菜单版本号重复提交应失败
PUT {{baseUrl}}/api/v1/roles/1/menus
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "menuIds": [2],
  "expectedVersion": "v1"
}
